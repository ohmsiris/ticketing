# --- LINE Messaging API ---
# From the LINE Developers Console > your channel > "Messaging API" tab.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE userId of each person. Leave blank on first deploy -- see README for
# how to find these from the webhook logs after each person sends one message.
OHM_LINE_USER_ID=
MOM_LINE_USER_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Optional ---
# Where the SQLite file lives. Defaults to data/tickets.db (relative to the
# repo root). On Railway/Render, point this at your persistent volume/disk.
DB_PATH=data/tickets.db

# Port the server listens on. Railway/Render set this automatically; only
# needed for local overrides.
PORT=8000

# Shared token to view the /tickets dashboard: https://.../tickets?token=xxxx
# Leave blank and the page is left open with no token required (fine for
# poking at it locally, NOT recommended once deployed -- there's no other
# auth on this app). Pick any random string.
DASHBOARD_TOKEN=

# --- Bill tracking (photographed repair bills -> review page -> Sheets) ---
# Full JSON key content (not a file path) for a Google service account with
# access to the Sheets below. See README's "Bill tracking setup" section.
GOOGLE_SERVICE_ACCOUNT_JSON=
BILLS_SHEET_ID=
LINE_ITEMS_SHEET_ID=
# Shared token to view/edit /bills?token=xxxx -- same idea as DASHBOARD_TOKEN
# above, same "no real login" caveat.
REVIEW_TOKEN=
# The deployed app's own URL, no trailing slash -- used to build links in
# LINE notifications (e.g. https://ticketing-production-xxxx.up.railway.app)
PUBLIC_BASE_URL=

# --- Vehicle roster auto-refresh (app/roster_sync.py) ---
# The "Drivers" Google Sheet's id (from its URL). Must be shared with the
# service account's email (the "client_email" field inside the JSON above)
# with at least Viewer access, or the daily refresh will fail silently
# (logged, not fatal -- the last-known-good app/vehicle_roster.csv is kept).
# Leave blank to disable auto-refresh entirely.
DRIVERS_SHEET_ID=
# Optional: tab name holding the roster tables, if it isn't the first tab.
DRIVERS_ROSTER_WORKSHEET=

# --- Payment slip tracking (photographed bank transfer slips -> review
# page -> the Accounting Sheet's "Transaction Log" tab) ---
# The "Accounting" Google Sheet's id (from its URL). Must be shared as
# EDITOR with the same service account used above (GOOGLE_SERVICE_ACCOUNT_
# JSON's client_email), since confirmed slips get WRITTEN there, not just
# read. Defaults to the one already in use for this business if left blank
# -- see README's "Payment slip tracking" section.
ACCOUNTING_SHEET_ID=1ygXYrtNzLAZ4eUVzD7ydlsACCH0QKHXdmf5LncX6ANM
# Optional: tab name, if it isn't literally "Transaction Log".
TRANSACTION_LOG_WORKSHEET=Transaction Log

# --- Preventive maintenance completion log (app/maintenance.py) ---
# A separate Google Sheet's id (from its URL) -- every completion reported
# via LINE appends one row here, no review step (unlike bills/slips above).
# Must be shared as EDITOR with the same service account
# (GOOGLE_SERVICE_ACCOUNT_JSON's client_email). Leave blank to disable --
# completions still work and log to the database either way, they just
# won't also appear in a Sheet.
MAINTENANCE_SHEET_ID=
# Optional: tab name, if it isn't the first tab.
MAINTENANCE_SHEET_WORKSHEET=

# --- Supply/parts purchase tracking (photographed bills for belts, bearings,
# chains, breakers, relays, etc. -> review page -> Sheets) ---
# Two separate Google Sheets ids (from their URLs), same shape as the bill-
# tracking pair above (BILLS_SHEET_ID / LINE_ITEMS_SHEET_ID) -- one row per
# purchase, one row per line item. Must be shared as EDITOR with the same
# service account (GOOGLE_SERVICE_ACCOUNT_JSON's client_email). Leave blank
# to disable Sheets sync -- purchases still work and save to the database
# either way, they just won't also appear in a Sheet. Reuses REVIEW_TOKEN
# above to gate /supplies?token=xxxx.
SUPPLIES_SHEET_ID=
SUPPLY_LINE_ITEMS_SHEET_ID=
# Optional third Sheet: one flat row per part purchased (supplier, branch,
# date, price -- purchase-level fields already joined in), meant to actually
# be read/sorted/filtered to see who sells a given part cheapest. Leave
# blank to skip this sync -- Supplies/SupplyLineItems above still work
# either way. Share as EDITOR with the same service account.
PART_PRICES_SHEET_ID=

# --- Parts-catalog seed auto-refresh (app/parts_catalog_sync.py) ---
# The user's own existing "Saraburi Maintenence Sheet" id (from its URL) --
# a daily job re-pulls its อะไหล่ Main / อะไหล่ / Motor Index Main tabs into
# app/known_parts_seed.txt, used as canonical_part matching context so
# supply-purchase extraction starts grounded against real parts already in
# use, not an empty list. Must be shared with the same service account
# (Viewer is enough -- this is read-only). Leave blank to disable; supply
# purchases still work fine, canonical_part just has nothing to match
# against until real purchases build up their own history.
PARTS_CATALOG_SHEET_ID=
